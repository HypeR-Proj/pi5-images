  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "pi5-images",
  "kind": "distribution",
  "tests": [
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "{component}/tests"
    ]
  ],
  "build": {
    "makefile": "mk/build.mk",
    "actions": {
      "*": [
        [
          "make",
          "-C",
          "{source}",
          "{action}",
          "OUT={output}"
        ]
      ]
    }
  },
  "test_requires_rust": false
}
